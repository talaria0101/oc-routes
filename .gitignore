# large refetchable catalog payloads (5MB each, live source of truth)
snapshots/models-api-*.json
snapshots/catalog-*.json
# atomic-write temp files + prior-spec backups (local, never commit)
*.tmp
*.prev.json
# python cache
__pycache__/
*.pyc
# local src checkouts
opencode-src/
# scratch prebuilt CLI (reinstall: bun add opencode-ai in /tmp/oc-bin)
oc-bin/
